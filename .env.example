# PostgreSQL
POSTGRES_USER=fituser
POSTGRES_PASSWORD=fitpass
POSTGRES_DB=fitdb

# Spring Boot Datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/fitdb
SPRING_DATASOURCE_USERNAME=fituser
SPRING_DATASOURCE_PASSWORD=fitpass

# JWT
APP_JWT_SECRET=change-me-to-a-random-secret-key
APP_JWT_EXPIRATION_MINUTES=1440

# Admin
APP_ADMIN_EMAIL=admin@example.com
